# Copy to .env and fill in. Never commit .env.
# .env is gitignored. config.yaml must not contain secrets.

# --- GitHub ---
# Classic or fine-grained PAT for the collector (and bot when PRPULSE_AUTH_MODE=pat).
GITHUB_TOKEN=
# Shared HMAC secret for POST /webhook (must match the GitHub webhook / App setting).
WEBHOOK_SECRET=
# pat = personal token (local/dev). app = GitHub App JWT + installation token.
PRPULSE_AUTH_MODE=pat
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# --- Data stores (Docker Compose defaults) ---
# Host port 5433 maps to Postgres in compose (avoids clashing with a local :5432).
DATABASE_URL=postgresql://prpulse:prpulse@127.0.0.1:5433/prpulse
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=prpulse
RQ_WORKER_CONCURRENCY=1

# --- Coverage / privacy ---
UNSEEN_REPO_MIN_RESOLVED=50
PAYLOAD_RETENTION_DAYS=90
PRIVACY_URL=

# --- Runtime gates ---
PRPULSE_REQUIRE_MODELS=0
PRPULSE_ADMIN_TOKEN=
PRPULSE_HOST=127.0.0.1
PRPULSE_PORT=8000
PRPULSE_BOT_DRY_RUN=

# --- Dashboard (Caddy basic auth). Hash with: caddy hash-password ---
DASHBOARD_USER=prpulse
DASHBOARD_PASSWORD_HASH=

# --- Alerts / backups ---
ALERT_WEBHOOK_URL=
ALERTMANAGER_SLACK_URL_FILE=./deploy/slack_url.placeholder
WEBHOOK_SILENCE_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# --- Pytest against Compose Postgres (optional) ---
# PRPULSE_TEST_DATABASE_URL=postgresql://prpulse:prpulse@127.0.0.1:5433/prpulse_test
