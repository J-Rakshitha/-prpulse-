{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "title": "PR Pulse",
  "uid": "prpulse-overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["prpulse"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request latency p50 / p95 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50 {{endpoint}}",
          "expr": "histogram_quantile(0.5, sum by (le, endpoint) (rate(prpulse_request_latency_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95 {{endpoint}}",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(prpulse_request_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{endpoint}} {{status}}",
          "expr": "sum by (endpoint, status) (rate(prpulse_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Live MAE of p50 forecast (hours) - placeholder until outcomes exist",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "h", "noValue": "no live data yet" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "MAE", "expr": "prpulse_live_mae_hours" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Live 10-90 interval coverage",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "noValue": "no live data yet" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "coverage", "expr": "prpulse_live_interval_coverage" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Resolved PRs with a prediction",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "prpulse_live_outcomes" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Predictions per minute by stage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "stage {{stage}}",
          "expr": "sum by (stage) (rate(prpulse_predictions_total[5m])) * 60"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhook deliveries by event and result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{event}} {{result}}",
          "expr": "sum by (event, result) (increase(prpulse_webhook_events_total[1h]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue depth",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "legendFormat": "depth", "expr": "prpulse_queue_depth" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Webhook ack latency p50 / p95",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(prpulse_webhook_ack_seconds_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prpulse_webhook_ack_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Worker failures / dead letters",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "legendFormat": "failed_jobs", "expr": "prpulse_failed_jobs" },
        { "refId": "B", "legendFormat": "dead_letters", "expr": "prpulse_dead_letter_count" },
        {
          "refId": "C",
          "legendFormat": "worker failed rate",
          "expr": "sum(rate(prpulse_worker_jobs_total{result=\"failed\"}[5m]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GitHub rate limit remaining",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "legendFormat": "remaining", "expr": "prpulse_github_rate_limit_remaining" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Coverage status split (stored predictions)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{status}}",
          "expr": "prpulse_coverage_status"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
